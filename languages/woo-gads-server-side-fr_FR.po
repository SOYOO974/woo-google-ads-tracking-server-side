msgstr "ID de commande invalide."

#: admin/class-woo-gads-admin.php:201
msgid "Order not found or unsupported order type (refunds cannot be resent)."
msgstr "Commande introuvable ou type non supporté (les remboursements ne peuvent pas être renvoyés)."

#: admin/class-woo-gads-admin.php:208
msgid "This order does not use a configured quote / lead payment method."
msgstr "Cette commande n'utilise pas un moyen de paiement de type devis / lead configuré."

#: admin/class-woo-gads-admin.php:225
msgid "Quote / Lead conversion tracking is currently disabled in plugin settings."
msgstr "Le suivi des conversions « Demande de devis » est actuellement désactivé dans les réglages du plugin."

#: admin/class-woo-gads-admin.php:229
#: admin/class-woo-gads-admin.php:266
msgid "Unknown status"
msgstr "Statut inconnu"

#. translators: 1: Order ID, 2: Payment method slug
#: admin/class-woo-gads-admin.php:240
#, php-format
msgid "Refused for Purchases: order #%1$d uses unpaid quote payment method \"%2$s\" (Status: Ignoré (devis, non payé))."
msgstr "Refusé pour Achats : la commande #%1$d utilise le moyen de paiement devis « %2$s » non payé (Statut : Ignoré (devis, non payé))."

#: admin/partials/woo-gads-admin-display.php:21
msgid "Test Mode (validateOnly) is active:"
msgstr "Mode test (validateOnly) actif :"

#: admin/partials/woo-gads-admin-display.php:22
msgid "Google Ads API validates every conversion request without recording conversions in your Google Ads account. Disable Test Mode in Configuration once your validation tests are complete."
msgstr "L'API Google Ads valide chaque requête de conversion sans l'enregistrer dans vos rapports Google Ads. Désactivez le mode test dans l'onglet Configuration une fois vos vérifications terminées."

